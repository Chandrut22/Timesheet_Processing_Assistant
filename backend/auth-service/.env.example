# auth-service settings that need a value in .env. Never commit the real .env.

# --- Logs and traces (OpenTelemetry) ---
# Every log record goes through OpenTelemetry and is printed on stdout.
LOG_LEVEL=INFO
OTEL_LOGS_CONSOLE=true
# text = normal log lines; json = one JSON object per line (for a log shipper).
OTEL_LOGS_FORMAT=text
# Trace ids on log lines (and step-log rows); docker compose turns this on.
OTEL_ENABLED=false
# Set to send logs and traces to an OpenTelemetry Collector (OTLP over HTTP).
# Blank = nothing leaves the process.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0

# --- Rate limit ---
# One limit for every endpoint: at most RATE_LIMIT requests ("requests/seconds") per client
# IP, counted together with core-service (same Redis). The IP comes from nginx's X-Real-IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT=100/60
# Redis down: true = let requests through, false = answer 503.
RATE_LIMIT_FAIL_OPEN=true
