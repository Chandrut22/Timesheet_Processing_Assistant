# Database Configuration
# Use "postgres" instead of "127.0.0.1" when running inside Docker
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/auth_db
DB_ECHO=false

# Redis Configuration
# Use "redis" instead of "127.0.0.1" when running inside Docker
REDIS_URL=redis://redis:6379/0

# Authentication & Security
OTP_SECRET=your-secure-random-otp-secret
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60

# JWT Configuration
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_SECURE=false

# Bootstrap Admin (used for initial setup)
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="Your App Name"
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_S=10

LOGIN_URL=http://localhost:5173/login