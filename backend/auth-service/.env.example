# Database Configuration
# Use "postgres" instead of "127.0.0.1" when running inside Docker
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/auth_db
DB_ECHO=false

# Redis Configuration
# Use "redis" instead of "127.0.0.1" when running inside Docker
REDIS_URL=redis://:change-me-to-a-long-random-hex-string@127.0.0.1:6380/0

# Authentication & Security
OTP_SECRET=your-secure-random-otp-secret
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60

# JWT Configuration
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_SECURE=false

# Bootstrap Admin (used for initial setup)
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="Your App Name"
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_S=10

LOGIN_URL=http://localhost:5173/login

# API docs (/docs, /redoc, /openapi.json): off by default, on for local development.
DOCS_ENABLED=true

# Paths callable without a token (everything else needs one). Default shown; the API
# docs are added automatically when DOCS_ENABLED=true.
# AUTH_PUBLIC_PATHS=["/health", "/health/db", "/auth/login", "/auth/refresh", "/auth/logout", "/auth/forgot-password", "/auth/reset-password"]

# Rate limits, "requests/window_seconds". strict = login, refresh, forgot / reset /
# change password, per IP; the others per signed-in user (or per IP when anonymous).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_STRICT=10/60
RATE_LIMIT_UPLOAD=20/60
RATE_LIMIT_DEFAULT=300/60
# RATE_LIMIT_EXEMPT_PATHS=["/health", "/health/db"]
# Proxies in front of the API that write X-Forwarded-For (nginx = 1; 0 = use the socket address).
TRUSTED_PROXY_HOPS=1

# Bulk import of users (POST /users/import): file size, rows per file, row details in
# the reply, and the zip-bomb limits for .xlsx files.
MAX_IMPORT_MB=5
MAX_IMPORT_ROWS=5000
# Users are also capped by this (Argon2 hashing takes ~0.15 s per new user).
MAX_USER_IMPORT_ROWS=200
IMPORT_REPORT_ROWS=200
MAX_UNCOMPRESSED_MB=100
MAX_COMPRESSION_RATIO=100
