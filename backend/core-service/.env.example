# core-service settings that need a value in .env. Never commit the real .env.

# --- Vision read: photos and scanned timesheets (OFF by default) ---
# Photos and PDFs without a text layer are classified (printed / handwritten / mixed)
# and transcribed by a vision model instead of OCR. When on, PAGE IMAGES ARE SENT TO
# VISION_BASE_URL. ollama.com is Ollama's hosted service (a third party); a
# self-hosted server is e.g. http://gpu-host:11434/v1.
VISION_ENABLED=false
# VISION_BASE_URL=https://ollama.com/v1
# VISION_API_KEY=<your Ollama API key>
# Exactly as the server lists it:
# VISION_MODEL=gemma4:31b-cloud
# VISION_PROVIDER=openai
VISION_TIMEOUT_S=120
VISION_MAX_RETRIES=2
VISION_MAX_OUTPUT_TOKENS=8000
# VISION_MAX_PAGES x VISION_TIMEOUT_S + 300 must fit in WORKER_JOB_TIMEOUT_SECONDS
VISION_MAX_PAGES=6
VISION_IMAGE_MAX_SIDE=2048
# A page classified with less confidence than this counts as "uncertain" (review).
VISION_MIN_CONFIDENCE=0.8

# --- Employee matching: close spellings (pg_trgm shortlists, difflib decides) ---
# A close spelling is only SUGGESTED (always reviewed). Needs the pg_trgm migration.
MATCH_FUZZY_ENABLED=true
MATCH_TRGM_MIN_SIMILARITY=0.2
MATCH_FUZZY_ACCEPT=0.85
MATCH_FUZZY_MARGIN=0.10

# --- Logs and traces (OpenTelemetry) ---
# Every log record goes through OpenTelemetry and is printed on stdout.
LOG_LEVEL=INFO
OTEL_LOGS_CONSOLE=true
# text = normal log lines; json = one JSON object per line (for a log shipper).
OTEL_LOGS_FORMAT=text
# Trace ids on log lines (and step-log rows); docker compose turns this on.
OTEL_ENABLED=false
# Set to send logs and traces to an OpenTelemetry Collector (OTLP over HTTP).
# Blank = nothing leaves the process.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0

# --- Long documents (chunking) ---
# Longer than CHUNK_TARGET_CHARS (or more than CHUNK_PEOPLE people): read in overlapping
# pieces, one AI call each, answers combined. More than CHUNK_MAX_PARTS pieces: the rest
# is not read and the timesheets are flagged document_too_large.
CHUNKING_ENABLED=true
CHUNK_TARGET_CHARS=12000
CHUNK_OVERLAP_CHARS=1500
CHUNK_PEOPLE=15
CHUNK_MAX_PARTS=40
CHUNK_PARALLEL=2
CHUNK_PIECE_RETRIES=2

# --- Rate limit ---
# One limit for every endpoint: at most RATE_LIMIT requests ("requests/seconds") per client
# IP, counted together with auth-service (same Redis). The IP comes from nginx's X-Real-IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT=100/60
# Redis down: true = let requests through, false = answer 503.
RATE_LIMIT_FAIL_OPEN=true

# --- Email: "Open in Gmail" links and mark as read ---
# The mailbox the system reads (same as IMAP_USER). Set it to show an "Open in Gmail"
# link on every email in the app; blank = no links.
MAILBOX_ACCOUNT=
# Link format: {account} and {message_id} are filled in (default: Gmail search by Message-ID).
# MAILBOX_LINK_TEMPLATE=https://mail.google.com/mail/?authuser={account}#search/rfc822msgid%3A{message_id}
# core-email only (docker compose reads it from backend/.env, like IMAP_USER): mark each
# email as read once it is saved; false = never change the mailbox.
IMAP_MARK_AS_READ=false
# Dashboard "Check mail now": least seconds between two manual checks (everyone together),
# and how old the listener's heartbeat may be before it shows as "not running".
EMAIL_MANUAL_CHECK_COOLDOWN_SECONDS=30
EMAIL_LISTENER_STALE_SECONDS=300
# Reprocess fetches an email again from the mailbox when its files are no longer stored
# (failed / expired attachment, ignored email). Read-only. Folders searched after
# IMAP_FOLDER, as JSON:
EMAIL_REFETCH_ENABLED=true
IMAP_REFETCH_FOLDERS=["[Gmail]/All Mail"]
