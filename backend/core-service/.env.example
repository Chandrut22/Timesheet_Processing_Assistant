
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:change-me-to-a-long-random-string@127.0.0.1:5433/timesheet_db
REDIS_URL=redis://:change-me-to-a-long-random-hex-string@127.0.0.1:6380/0
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem


LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-oss-20b

# --- Attachment classifier (Jev by TypeSafe): optional, OFF by default ---
# Switch: CLASSIFIER_ENABLED=true turns it on (needs JEV_API_KEY, or the service won't start).
# With CLASSIFIER_SHADOW_ONLY=true it only logs what it would skip; set false to really skip.
# Off, errors, timeouts and manual reprocess: every file goes to AI extraction as usual.
CLASSIFIER_ENABLED=false
CLASSIFIER_SHADOW_ONLY=true
CLASSIFIER_SKIP_BELOW=0.2
JEV_API_KEY=

# --- Big sheets (many people on one sheet) ---
# Above CHUNK_ABOVE_PEOPLE people, the sheet is cut into pieces of CHUNK_PEOPLE people,
# one AI call per piece (CHUNK_PARALLEL at a time), answers merged. Smaller: one call.
CHUNKING_ENABLED=true
CHUNK_ABOVE_PEOPLE=25
CHUNK_PEOPLE=15
CHUNK_PARALLEL=2

# API docs (/docs, /openapi.json): off by default, on for local development.
DOCS_ENABLED=true

# DOCX / XLSX safety: refuse files that unpack to more than this (MB) or are compressed
# more than this ratio to 1 (zip bombs).
MAX_UNCOMPRESSED_MB=100
MAX_COMPRESSION_RATIO=100

# Paths callable without a token (everything else needs one). Default shown; the API
# docs are added automatically when DOCS_ENABLED=true.
# AUTH_PUBLIC_PATHS=["/health", "/health/db", "/health/redis"]

# Rate limits, "requests/window_seconds", per signed-in user (or per IP when not signed in).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_UPLOAD=20/60
RATE_LIMIT_EXPORT=30/60
RATE_LIMIT_DEFAULT=300/60
# RATE_LIMIT_EXEMPT_PATHS=["/health", "/health/db", "/health/redis"]
# Proxies in front of the API that write X-Forwarded-For (nginx = 1; 0 = use the socket address).
TRUSTED_PROXY_HOPS=1

# Bulk import (employees, companies, holidays): file size, rows, row details returned.
MAX_IMPORT_MB=5
MAX_IMPORT_ROWS=5000
IMPORT_REPORT_ROWS=200
