# Optional: where the dev server forwards API calls (defaults shown).
# No secrets belong here: the browser only talks to the Vite proxy.
AUTH_URL=http://127.0.0.1:8001
CORE_URL=http://127.0.0.1:8002

# Optional: Jaeger UI. When set, each processing step shows "Open trace".
VITE_JAEGER_URL=http://localhost:16686
